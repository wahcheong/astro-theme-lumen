---
import config from "virtual:astro-theme-lumen/config";
import Icon from "./Icon.astro";

interface Props {
  /** Renders compact icon-only links instead of labelled ones. */
  compact?: boolean;
  class?: string;
}

const { compact = false } = Astro.props;
const className = Astro.props.class ?? "";
const socials = config.socials;
---

{
  socials.length > 0 && (
    <ul class:list={["flex items-center gap-1", className]}>
      {socials.map(link => (
        <li>
          <a
            href={link.url}
            rel="me noopener noreferrer"
            target={link.url.startsWith("http") ? "_blank" : undefined}
            aria-label={link.label ?? link.name}
            title={link.label ?? link.name}
            class:list={[
              "inline-flex items-center gap-2 rounded-full text-muted transition-colors hover:text-hover-ink",
              compact
                ? "size-9 justify-center hover:bg-hover-surface"
                : "px-3 py-1.5 text-sm hover:bg-hover-surface",
            ]}
          >
            <Icon name={link.name} size={compact ? 18 : 16} />
            {!compact && <span>{link.label ?? link.name}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}
