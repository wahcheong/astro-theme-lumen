---
/**
 * The search overlay.
 *
 * Rendered from `BaseLayout` rather than from the header, so it is a direct
 * child of `<body>`. The header has `backdrop-filter`, and a top-layer dialog
 * under a filtered ancestor is composited unreliably in Chrome — the symptom is
 * a dark fringe around the panel that comes and goes.
 *
 * Pagefind's bundle is fetched on first open rather than up front: it is around
 * 130 KB, which is a poor trade against a homepage that otherwise ships no
 * script beyond the theme toggle.
 */
---

{/*
  `bg-surface` rather than `bg-canvas`: the two are identical in light mode, but
  in dark mode surface is a step lighter, which separates the panel from the
  page without drawing a border around it.
*/}
<dialog
  data-search-dialog
  aria-label="Search"
  class="mx-auto mb-0 mt-[8vh] w-[min(44rem,calc(100vw-2rem))] rounded-2xl bg-surface p-0 text-ink shadow-lift backdrop:bg-black/40"
>
  <div class="flex max-h-[80dvh] flex-col">
    {/* No title bar: it only carried a label and a close button, and Esc and a
        backdrop click already close the dialog. `min-h-0` lets this shrink
        inside the flex column so results scroll instead of pushing the panel
        past the viewport. */}
    <div
      id="lumen-search-overlay"
      class="lumen-search min-h-0 flex-1 overflow-y-auto p-4"
    >
    </div>

    <noscript>
      <p class="px-4 pb-4 text-sm text-muted">
        Search needs JavaScript.{" "}
        <a href="/posts" class="text-ink underline underline-offset-4">
          Browse all posts
        </a>.
      </p>
    </noscript>
  </div>
</dialog>

<script is:inline>
  (() => {
    const trigger = document.querySelector("[data-search-open]");
    const dialog = document.querySelector("[data-search-dialog]");
    if (!trigger || !dialog) return;

    const mountSelector = "#lumen-search-overlay";
    let ready = false;

    /**
     * Say so when there is nothing to load.
     *
     * `astro dev` never serves `dist/pagefind`, so the bundle 404s there. Fail
     * loudly rather than leaving someone with a dialog and no input box.
     */
    const showUnavailable = () => {
      const node = dialog.querySelector(mountSelector);
      if (!node || node.childElementCount > 0) return;

      const note = document.createElement("p");
      note.className = "py-6 text-sm text-muted";
      note.textContent =
        "Search runs off the built site. Run a build, then open the preview.";

      node.append(note);
    };

    /** Load Pagefind's UI bundle, unless a page already did. */
    const loadUi = async () => {
      if (!document.querySelector("link[data-pagefind-ui]")) {
        const style = document.createElement("link");
        style.rel = "stylesheet";
        style.href = "/pagefind/pagefind-ui.css";
        style.setAttribute("data-pagefind-ui", "");
        document.head.append(style);
      }

      if (typeof window.PagefindUI !== "function") {
        await new Promise((resolve, reject) => {
          const script = document.createElement("script");
          script.src = "/pagefind/pagefind-ui.js";
          script.onload = resolve;
          script.onerror = reject;
          document.head.append(script);
        });
      }

      new window.PagefindUI({
        element: mountSelector,
        showSubResults: true,
        showImages: false,
        resetStyles: false,
      });
      ready = true;
      autoLoadMore();
    };

    /**
     * Fetch further result pages as the list nears its end.
     *
     * Pagefind renders a "Load more results" button and offers no option to
     * auto-load, so the button is clicked for the reader when it comes into
     * view. The button is replaced after each page, hence the mutation
     * observer re-arming the intersection observer.
     */
    const autoLoadMore = () => {
      const container = dialog.querySelector(mountSelector);
      if (!container || typeof IntersectionObserver !== "function") return;

      let watched;

      const observer = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) watched?.click();
        },
        // Load a little before the button is actually on screen.
        { root: container, rootMargin: "200px" }
      );

      const arm = () => {
        const button = container.querySelector(".pagefind-ui__button");
        if (button === watched) return;

        if (watched) observer.unobserve(watched);
        watched = button ?? undefined;
        if (watched) observer.observe(watched);
      };

      arm();
      new MutationObserver(arm).observe(container, {
        childList: true,
        subtree: true,
      });
    };

    trigger.addEventListener("click", async () => {
      dialog.showModal();

      if (!ready) {
        try {
          await loadUi();
        } catch {
          showUnavailable();
        }
      }

      dialog.querySelector("input")?.focus();
    });

    // Esc closes natively; a click on the backdrop should close it too, since
    // the dialog carries no close button.
    dialog.addEventListener("click", event => {
      if (event.target === dialog) dialog.close();
    });

    /**
     * Start fresh on every open.
     *
     * Pagefind already clears its input when Esc is pressed inside it, while a
     * backdrop click leaves the query behind — the same dismissal behaving two
     * ways is confusing, so close always clears.
     */
    dialog.addEventListener("close", () => {
      const input = dialog.querySelector("input");
      if (!input || input.value === "") return;

      input.value = "";
      input.dispatchEvent(new Event("input", { bubbles: true }));
    });
  })();
</script>
