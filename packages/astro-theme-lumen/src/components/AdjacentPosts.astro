---
import Icon from "./Icon.astro";
import type { LumenEntry } from "../utils/posts";

interface Props {
  older?: LumenEntry;
  newer?: LumenEntry;
}

const { older, newer } = Astro.props;

const cardClass =
  "group flex min-w-0 flex-col gap-1 rounded-card border border-line bg-surface p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-hover-line hover:shadow-card";
---

{
  (older || newer) && (
    <nav
      aria-label="Adjacent posts"
      class="mt-14 grid gap-3 border-t border-line pt-8 sm:grid-cols-2"
    >
      {newer ? (
        <a href={`/posts/${newer.id}`} class={cardClass}>
          <span class="inline-flex items-center gap-1.5 text-xs text-subtle">
            <Icon name="arrow-left" size={13} />
            Newer
          </span>
          <span class="truncate font-medium text-ink transition-colors group-hover:text-hover-ink">
            {newer.data.title}
          </span>
        </a>
      ) : (
        <span />
      )}

      {older ? (
        <a href={`/posts/${older.id}`} class={`${cardClass} sm:text-end sm:items-end`}>
          <span class="inline-flex items-center gap-1.5 text-xs text-subtle">
            Older
            <Icon name="arrow-right" size={13} />
          </span>
          <span class="truncate font-medium text-ink transition-colors group-hover:text-hover-ink">
            {older.data.title}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
