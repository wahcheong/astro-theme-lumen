---
import Icon from "./Icon.astro";

/**
 * The header's search affordance.
 *
 * Kept apart from the overlay itself: the dialog must not live inside the
 * header, because the header carries `backdrop-filter`, and a top-layer element
 * under a filtered ancestor is composited unreliably — it shows up as an
 * intermittent dark fringe around the panel.
 */
---

<button
  type="button"
  data-search-open
  class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-hover-surface hover:text-hover-ink"
  aria-label="Search"
  title="Search"
>
  <Icon name="search" size={18} />
</button>
