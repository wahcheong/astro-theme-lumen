---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPage, renderEntry } from "../utils/posts";

const page = await getPage("about");
const rendered = page ? await renderEntry(page) : undefined;

const title = page?.data.title ?? "About";
const description = page?.data.description;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main id="main" class="lumen-shell py-10 sm:py-14">
    <article>
      <h1 class="text-[1.75rem] font-semibold tracking-tight text-ink">{title}</h1>

      {description && <p class="mt-3 text-muted">{description}</p>}

      <div class="lumen-prose mt-8">
        {
          rendered ? (
            <rendered.Content />
          ) : (
            <p>
              No about page found. Create{" "}
              <code>src/content/pages/about.md</code> to fill this in.
            </p>
          )
        }
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>
