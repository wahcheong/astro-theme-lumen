---
import type { GetStaticPaths } from "astro";
import config from "virtual:astro-theme-lumen/config";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import Pagination from "../../../components/Pagination.astro";
import PostCard from "../../../components/PostCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { LumenEntry } from "../../../utils/posts";
import { getSortedPosts, paginate } from "../../../utils/posts";

/**
 * Page 1 lives at `/posts`, so only pages 2..n are generated here. Keeping the
 * literal `page` segment also means this route always outranks `/posts/[...slug]`.
 */
export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  const pages = paginate(posts, config.posts.perPage);

  return pages.slice(1).map((entries, index) => ({
    params: { page: String(index + 2) },
    props: {
      entries,
      currentPage: index + 2,
      totalPages: pages.length,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entries: LumenEntry[];
  currentPage: number;
  totalPages: number;
}

const { entries, currentPage, totalPages } = Astro.props;
---

<BaseLayout
  title={`Posts — page ${currentPage}`}
  description={`Page ${currentPage} of ${totalPages} on ${config.site.title}.`}
>
  <Header />

  <main id="main" class="lumen-shell py-10 sm:py-14">
    <header class="mb-8">
      <h1 class="text-[1.75rem] font-semibold tracking-tight text-ink">Posts</h1>
      <p class="mt-2 text-muted">
        Page {currentPage} of {totalPages}
      </p>
    </header>

    <ul class="grid gap-4">
      {
        entries.map(post => (
          <li>
            <PostCard post={post} />
          </li>
        ))
      }
    </ul>

    <Pagination
      currentPage={currentPage}
      totalPages={totalPages}
      basePath="/posts"
      class="mt-12"
    />
  </main>

  <Footer />
</BaseLayout>
