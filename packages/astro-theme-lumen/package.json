    "tailwindcss-v4",
    "mdx",
    "typescript",
    "static-site",
    "withastro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahcheong/astro-theme-lumen.git"
  },
  "bugs": {
